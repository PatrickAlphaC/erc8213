# Mainnet RPC URL (required). Alchemy, Infura, llamarpc, or any other mainnet node.
MAINNET_RPC_URL=

# Pinata JWT (optional). If set, the build is mirrored to Pinata and the
# returned CID is checked against the locally-computed one. Get a key at
# https://app.pinata.cloud/developers/api-keys.
PINATA_JWT=
